expr main (a lots)

let message "Did you mean `a lot`, the contraction `a lot's`, or `lots`?"
let description "Corrects `a lots` to `a lot`, the contraction `a lot's`, or `lots`."
let kind "Usage"
let becomes ["a lot", "a lot's", "lots"]

# a lot (the common case: a stray `s` on `a lot`)
test "Thanks a lots for your support." "Thanks a lot for your support."
# a lot's (contraction of `a lot has`)
test "a lots changed overtime, add latest depends support" "a lot's changed overtime, add latest depends support"
# a lot's (contraction of `a lot is`)
test "A lots changing around here!" "A lot's changing around here!"
# lots
test "Thanks a lots for your support." "Thanks lots for your support."
